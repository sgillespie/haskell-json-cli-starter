cabal-version: 3.0
name: json-demo
version: 0.1.0.0
synopsis: A walking-skeleton starter for Haskell JSON CLI tools
homepage: https://github.com/sgillespie/haskell-json-cli-starter
license: MIT
license-file: LICENSE
author: Sean Gillespie
maintainer: sean@mistersg.net
copyright: 2026 Sean Gillespie
category: Text
build-type: Simple
data-files:
  test/data/example.json

common common-options
  ghc-options: -Wall
  build-depends:
    aeson,
    aeson-pretty,
    base <5,
    bytestring,
    containers,
    text,
    time,
    vector,

  default-extensions:
    DeriveAnyClass
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    RecordWildCards

  default-language: GHC2021

library
  import: common-options
  exposed-modules: Lib
  hs-source-dirs: src

executable json-demo
  import: common-options
  main-is: Main.hs
  build-depends:
    json-demo,
    optparse-applicative,

  hs-source-dirs: app
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

test-suite json-test
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Paths_json_demo

  build-depends:
    hspec,
    hspec-expectations,
    json-demo,
